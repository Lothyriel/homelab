# CoreDNS Configuration — Split-horizon DNS for *.loty.click
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Ad blocking — applies to ALL queries
# -----------------------------------------------------------------------------
(adblock) {
    hosts /etc/coredns/blocklist.hosts {
        fallthrough
    }
}

# -----------------------------------------------------------------------------
# 1. Local / private network clients (10.0.0.0/8)
# -----------------------------------------------------------------------------
loty.click {
    view lan {
	expr incidr(client_ip(), '10.0.0.0/8')
    }

    template IN A {
        match .*\.loty\.click
        answer "{{ .Name }} 86400 IN A 10.0.0.10"
    }

    cache
    log
}

# -----------------------------------------------------------------------------
# 2. VPN clients (Tailscale/WireGuard CGNAT range: 100.64.0.0/10)
# -----------------------------------------------------------------------------
loty.click {
    view vpn {
        expr incidr(client_ip(), '100.64.0.0/10')
    }

    template IN A {
        match .*\.loty\.click
        answer "{{ .Name }} 86400 IN A 100.83.54.110"
    }

    cache
    log
}

# -----------------------------------------------------------------------------
# 3. Forward all non-loty.click queries upstream
# -----------------------------------------------------------------------------
. {
    forward . 172.18.0.1 172.18.0.2
    cache
    log
}
