[Unit]
Description=Bazarr
PartOf=media.pod
After=media.pod

[Container]
Pod=media.pod
Image=lscr.io/linuxserver/bazarr:latest
ContainerName=bazarr

Volume=%h/arr/bazarr:/config:Z
Volume=/media0/movies:/movies0:z
Volume=/media1/movies:/movies1:z
Volume=/media0/shows:/shows0:z
Volume=/media1/shows:/shows1:z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=America/Sao_Paulo

[Service]
Restart=always
CPUWeight=50
