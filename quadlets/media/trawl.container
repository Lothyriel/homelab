[Unit]
Description=Trawl (Anti-bot bypass service for *arr stack)
PartOf=media.pod
After=media.pod

[Container]
Pod=media.pod
Image=ghcr.io/germondai/trawl:latest
ContainerName=trawl
AutoUpdate=registry
ShmSize=1g

Environment=TZ=America/Sao_Paulo
Environment=BROWSER_POOL_SIZE=1

[Service]
Restart=always
