[Unit]
Description=Radarr
PartOf=media.pod
After=media.pod

[Container]
Pod=media.pod
Image=lscr.io/linuxserver/radarr:latest
ContainerName=radarr

Volume=%h/arr/radarr:/config:Z
Volume=%h/arr/downloads:/downloads:z
Volume=/media0/movies:/movies0:z
Volume=/media1/movies:/movies1:z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=America/Sao_Paulo

[Service]
Restart=always
CPUWeight=50
