[Unit]
Description=Radarr
PartOf=media.pod
After=media.pod

[Container]
Pod=media.pod
Image=lscr.io/linuxserver/radarr:latest
ContainerName=radarr

Volume=%h/arr/radarr:/config:Z
Volume=/data/media/downloads:/downloads:z
Volume=/data/media/movies:/movies:z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=America/Sao_Paulo

[Service]
Restart=always
CPUWeight=50
