[Unit]
Description=Sonarr
PartOf=media.pod
After=media.pod

[Container]
Pod=media.pod
Image=lscr.io/linuxserver/sonarr:latest
ContainerName=sonarr

Volume=%h/arr/sonarr:/config:Z
Volume=%h/arr/downloads:/downloads:z
Volume=/media0/shows:/shows0:z
Volume=/media1/shows:/shows1:z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=America/Sao_Paulo

[Service]
Restart=always
CPUWeight=50
