[Unit]
Description=Sonarr
PartOf=media.pod
After=media.pod

[Container]
Pod=media.pod
Image=lscr.io/linuxserver/sonarr:latest
ContainerName=sonarr

Volume=%h/arr/sonarr:/config:Z
Volume=%h/arr/downloads:/downloads:z
Volume=/data/media/shows:/shows:z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=America/Sao_Paulo

[Service]
Restart=always
CPUWeight=50
