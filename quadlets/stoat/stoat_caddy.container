[Unit]
Description=Stoat Internal Caddy
After=stoat_api.service stoat_events.service stoat_autumn.service stoat_january.service stoat_gifbox.service stoat_livekit.service stoat_voice_ingress.service stoat_web.service

[Container]
Pod=stoat.pod
ContainerName=stoat-caddy
Image=docker.io/library/caddy:2-alpine
Volume=./Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=./stoat.json:/stoat.json:ro,Z

[Service]
Restart=always

[Install]
WantedBy=default.target
