[Unit]
Description=Stoat Voice Ingress
PartOf=stoat-pod.service
After=stoat-pod.service stoat_database.service stoat_rabbit.service
Requires=stoat_database.service stoat_rabbit.service

[Container]
Pod=stoat.pod
ContainerName=stoat-voice-ingress
Image=ghcr.io/stoatchat/voice-ingress:v0.15.1
EnvironmentFile=.env
Volume=./Revolt.toml:/Revolt.toml:ro,Z

[Service]
ExecStartPre=/usr/bin/bash %h/homelab/quadlets/stoat/wait-for-rabbit.sh stoat-rabbit
Restart=always

[Install]
WantedBy=default.target
