[Unit]
Description=Pocket Planner app
After=network-online.target pocket-planner-api.service
Wants=network-online.target

[Container]
Pod=pocket-planner.pod
ContainerName=pocket-planner-app
Image=ghcr.io/lothyriel/pocketplanner-app:latest
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=60
CPUWeight=50

[Install]
WantedBy=default.target
